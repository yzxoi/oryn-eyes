FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace_me
FEISHU_DOMAIN=feishu
ORYN_EYES_URL=http://127.0.0.1:18080
ORYN_EYES_BUDGET_SECONDS=900
FEISHU_MAX_PENDING=20
FEISHU_ALLOW_PRIVATE=true
# Comma-separated group chat IDs; empty allows all groups the bot has joined.
FEISHU_ALLOWED_CHAT_IDS=
# Use the Python environment with Pillow installed; choose the absolute path on your host.
# ORYN_PYTHON=/home/your-user/oryn-eyes/.venv/bin/python
